# Copy to .env and edit. Never commit .env.

# ---- LLM -----------------------------------------------------------------
# auto       -> Groq if GROQ_API_KEY is set, otherwise offline "extractive" mode
# groq       -> Groq Cloud (free tier available), https://console.groq.com/keys
# openai_compat -> any OpenAI-compatible endpoint (OpenRouter, Together, local vLLM/Ollama...)
# extractive -> no LLM; answers are verbatim sentences from retrieved passages
LLM_PROVIDER=auto
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
# Only for LLM_PROVIDER=openai_compat
LLM_API_KEY=

# ---- Retrieval -----------------------------------------------------------
# bm25 | ngram | dense | hybrid (bm25+ngram+dense) | hybrid_lex (bm25+ngram)
RETRIEVAL_MODE=hybrid
# bge-m3 | multilingual-e5 | labse | offline-lsa
EMBED_MODEL=bge-m3
# native | translate_query | translate_docs | index_both  (combine with "+")
TRANSLATION_STRATEGY=native
QUERY_EXPANSION=true
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHUNKING=structure
TOP_K=5

# ---- App -----------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to the built frontend folder to serve UI + API from one process (Render / HF Spaces)
STATIC_DIR=
# Folder with eng/hin/mar .traineddata files (see scripts/setup_tessdata.sh)
TESSDATA_DIR=
